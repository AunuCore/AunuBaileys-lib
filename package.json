{
  "name": "aunubaileys",
  "type": "module",
  "version": "2.0.0",
  "description": "AunuBaileys — the self-healing WhatsApp Web API for Node.js. Bad MAC and \"2000 messages into the future\" errors repair themselves, LID and phone-number identities stay in sync, anti-ban is built in, pairing codes are custom — plus 34 experimental features no other Baileys fork ships: invisible watermarks, per-person tag-all cards, side-profile text, ghost mentions and more. ESM, CJS and full TypeScript types.",
  "keywords": [
    "whatsapp",
    "whatsapp-web",
    "whatsapp-api",
    "whatsapp-web-api",
    "whatsapp-bot",
    "whatsapp-automation",
    "whatsapp-md",
    "multi-device",
    "baileys",
    "baileys-mod",
    "baileys-fork",
    "whiskeysockets",
    "aunubaileys",
    "aunucore",
    "wa-bot",
    "wa-api",
    "bot-wa",
    "bot-whatsapp",
    "bot-wa-indonesia",
    "script-bot-wa",
    "base-bot-wa",
    "library-bot-wa",
    "pairing-code",
    "qr-code",
    "lid-support",
    "pn-lid",
    "whatsapp-newsletter",
    "whatsapp-channel",
    "whatsapp-status",
    "whatsapp-groups",
    "interactive-message",
    "sticker-pack",
    "poll",
    "view-once",
    "disappearing-messages",
    "signal-protocol",
    "libsignal",
    "anti-ban",
    "self-healing",
    "bad-mac",
    "websocket",
    "nodejs",
    "typescript",
    "esm",
    "gateway",
    "chatbot"
  ],
  "homepage": "https://docsjs.aunucore.eu.cc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AunuCore/AunuBaileys-lib.git"
  },
  "license": "MIT",
  "author": "AunuCore Creative Network",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib/**/*",
    "WAProto/**/*",
    "engine-requirements.js"
  ],
  "scripts": {
    "build": "tsc -P tsconfig.build.json && tsc-esm-fix --tsconfig=tsconfig.build.json --ext=.js",
    "gen:protobuf": "sh WAProto/GenerateStatics.sh",
    "lint": "tsc -P tsconfig.build.json",
    "prepack": "npm run build",
    "prepare": "npm run build",
    "preinstall": "node ./engine-requirements.js",
    "test": "npm run build && node --test test/*.test.mjs",
    "test:e2e": "NODE_OPTIONS=--experimental-vm-modules NODE_TLS_REJECT_UNAUTHORIZED=0 npx --yes jest --runInBand --forceExit --testMatch '**/*.test-e2e.ts'",
    "test:upstream": "NODE_OPTIONS=--experimental-vm-modules npx --yes jest --testMatch '**/*.test.ts'"
  },
  "dependencies": {
    "@hapi/boom": "^9.1.3",
    "libsignal": "^6.0.0",
    "pino": "^9.6",
    "protobufjs": "^7.5.6",
    "whatsapp-rust-bridge": "0.5.4",
    "ws": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^20.9.0",
    "@types/ws": "^8.0.0",
    "link-preview-js": "^3.0.0",
    "tsc-esm-fix": "^3.1.2",
    "typescript": "^5.8.2"
  },
